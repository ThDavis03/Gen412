PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma o comodín en desarrollo)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Duración por defecto de cada pregunta en ms (ej. 15000 = 15s)
DEFAULT_QUESTION_DURATION_MS=15000
# Puntuación máxima y mínima para la función de decaimiento
MAX_SCORE=1000
MIN_SCORE=200
